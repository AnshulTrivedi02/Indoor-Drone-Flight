# =====================================================================================================================
# RUNG 1 REAL-SENSOR PARAMETER TEMPLATE  (R6, docs/minimal_real_flight_plan.md section 3.3; written 2026-10-10)
# =====================================================================================================================
# Status: DRAFT. Not yet loaded on any vehicle. Load order on the flight controller (FC):
#   1. the vehicle's own existing parameter dump (its tune, RC calibration, motor setup: we do not change those);
#   2. THIS file;
#   3. EXACTLY ONE compass variant: rung1_variant_nomag.parm OR rung1_variant_compass.parm (supervisor's decision).
# Then reboot, and read every value back from the FC (the eeprom gotcha, CLAUDE.md Known Issue #10, applies on hardware).
#
# Before loading:  python3 realflight/params/check_parm.py --final rung1_template.parm rung1_variant_<x>.parm
# It refuses AHRS_EKF_TYPE 10, any SIM_* line, any TODO_SUPERVISOR value left in --final mode, and a missing or
# duplicated compass/yaw choice.
#
# Every parameter NAME below was verified to exist at the pinned commit 7bac20cbcc (tag thesis-baseline):
#   - against the live PARM dump of a SITL build of that source (cl_a_tex_half/ardupilot.bin, 1379 parameters), and
#   - against the @Param tags in ~/ardupilot (the source file is named next to each group).
# Values marked TODO_SUPERVISOR depend on the board, the sensors or the flight volume. A value of TODO_SUPERVISOR is not a
# number, so a ground station refuses to load the file until it is replaced (intended).
#
# Frames: FRD body (x forward, y right, z DOWN), metres, origin = the vehicle's body/IMU origin. Measure the mounts.
# =====================================================================================================================

# ---------------------------------------------------------------------------------------------------------------------
# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
# AHRS_EKF_TYPE MUST BE 3 (EKF3). NEVER 10.
# 10 is EKFType::SIM, the SIMULATOR'S PERFECT STATE. On a real FC there is no simulator: the vehicle would fly on a state
# that does not exist. consolidated_rerun.parm (the simulation's file) carries AHRS_EKF_TYPE 10 and must NEVER be loaded
# on a real FC. check_parm.py refuses any file containing AHRS_EKF_TYPE 10.
# Source: libraries/AP_AHRS/AP_AHRS.cpp @Param EKF_TYPE, @Values 0:Disabled,2:EKF2,3:EKF3,10:Sim,11:ExternalAHRS.
# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
AHRS_EKF_TYPE 3          # EKF3 is the estimator the vehicle reports and flies on (ALT_HOLD uses its height)
EK3_ENABLE 1             # EKF3 running (AP_NavEKF3.cpp @Param ENABLE)
EK2_ENABLE 0             # EKF2 off: one EKF, as in every simulated flight (AP_NavEKF2.cpp @Param ENABLE)
SCHED_LOOP_RATE 400      # main loop 400 Hz: EKF3 predicts on 5 accumulated frames = 12.5 ms, the dt the UKF/FGO noise
                         # matching assumes (CLAUDE.md "EKF3 Prediction dt"). Read back; do not change on the vehicle.

# ---------------------------------------------------------------------------------------------------------------------
# EKF3 SOURCES: flow velocity, rangefinder height, NO GPS  (libraries/AP_NavEKF/AP_NavEKF_Source.cpp)
# Same as the simulation's gnss_denied.parm. The yaw source (EK3_SRC1_YAW) is in the compass variant files.
# ---------------------------------------------------------------------------------------------------------------------
EK3_SRC1_POSXY 0         # None: horizontal position is flow dead reckoning (there is no OpticalFlow POSXY value)
EK3_SRC1_VELXY 5         # OpticalFlow: horizontal velocity from the flow sensor
EK3_SRC1_POSZ 2          # RangeFinder: height from the downward rangefinder (not Baro)
EK3_SRC1_VELZ 0          # None: VELZ defaults to GPS (3); this closes that gap
EK3_RNG_USE_HGT -1       # rangefinder height switching off (POSZ is already the rangefinder), as in the simulation
EK3_GSF_RUN_MASK 3       # documents the default; the GSF yaw estimator needs GPS and never runs here
EK3_GSF_USE_MASK 3       # documents the default (as gnss_denied_nomag.parm)

# ---------------------------------------------------------------------------------------------------------------------
# EKF3 FLOW FUSION  (libraries/AP_NavEKF3/AP_NavEKF3.cpp)
# Noise, gate and limit at their defaults, written out so a readback proves them: the UKF/FGO copy these values.
# ---------------------------------------------------------------------------------------------------------------------
EK3_FLOW_USE 1           # 1 = Navigation (2 = terrain only would make readyToUseOptFlow() fail)
EK3_FLOW_M_NSE 0.25      # flow measurement noise, rad/s (default)
EK3_FLOW_I_GATE 300      # flow innovation gate, 3 sigma (default)
EK3_FLOW_MAX 2.5         # flow rates above this (rad/s) are rejected (default)
EK3_FLOW_DELAY TODO_SUPERVISOR   # ms from the end of the sensor's averaging period to arrival (0-250, default 10).
                         # From the sensor's documentation or a measurement. The UKF port reads this value from the log
                         # (R2), so it is the same delay for EKF3 and the UKF. Note EKF3 adds a fixed 50 ms
                         # (flowTimeDeltaAvg_ms, a 10 Hz assumption) on top: see the pre-registration's timestamp rule.
EK3_HGT_DELAY 60         # height measurement delay, ms (default; also sets the fusion horizon with FLOW_DELAY)

# ---------------------------------------------------------------------------------------------------------------------
# OPTICAL FLOW SENSOR  (libraries/AP_OpticalFlow/AP_OpticalFlow.cpp)
# ---------------------------------------------------------------------------------------------------------------------
FLOW_TYPE TODO_SUPERVISOR        # 0 None, 1 PX4Flow, 2 Pixart (PMW3901 on SPI), 5 MAVLink (e.g. MTF-01 in MAVLink mode),
                                 # 6 DroneCAN (HereFlow), 7 MSP, 8 UPFLOW. Needs a reboot (backend built once at boot).
FLOW_ORIENT_YAW TODO_SUPERVISOR  # centidegrees the sensor's X axis is yawed from the vehicle's X (positive = to the right).
                                 # PROVEN on the bench by the sign check (flight cards B4), not trusted from the mount.
FLOW_POS_X TODO_SUPERVISOR       # m, focal point forward of the body origin (measured)
FLOW_POS_Y TODO_SUPERVISOR       # m, to the right (measured)
FLOW_POS_Z TODO_SUPERVISOR       # m, DOWN from the body origin (measured; a sensor under the frame is positive).
                                 # EKF3 subtracts it from the range (OptFlowFusion.cpp:314-318); the UKF port uses all three
                                 # in its lever-arm term and z in its height (R2).
FLOW_FXSCALER 0          # X scale correction, parts per thousand. 0 unless a calibration flight says otherwise; a
                         # scale error is shared by all three estimators (they read the same flow records)
FLOW_FYSCALER 0          # Y scale correction, as above
FLOW_OPTIONS 0           # bit 0 "roll/pitch stabilised" must NOT be set: the sensor is rigidly mounted (raw flow, the
                         # estimators derotate), as in the simulation
FLOW_ADDR TODO_SUPERVISOR        # I2C address selector (sensor-dependent; 0 for most). Not used by SPI/CAN sensors.

# ---------------------------------------------------------------------------------------------------------------------
# DOWNWARD RANGEFINDER  (libraries/AP_RangeFinder/AP_RangeFinder_Params.cpp; names checked: the minimum/maximum are
# RNGFND1_MIN/RNGFND1_MAX in METRES at this commit, and the ground clearance is RNGFND1_GNDCLR, NOT "GNDCLEAR")
# ---------------------------------------------------------------------------------------------------------------------
RNGFND1_TYPE TODO_SUPERVISOR     # driver: e.g. Benewake TF-Luna/TFmini serial, VL53L1X I2C (value from the @Values list)
RNGFND1_ORIENT 25        # 25 = Down (ROTATION_PITCH_270): EKF3 and the UKF port only use a downward rangefinder
RNGFND1_MIN TODO_SUPERVISOR      # m, the datasheet minimum. CHECK: if it exceeds the resting height the sensor reads
                                 # "out of range low" on the ground (see GNDCLR and the open question in the handover)
RNGFND1_MAX TODO_SUPERVISOR      # m, the datasheet maximum usable indoors
RNGFND1_GNDCLR TODO_SUPERVISOR   # m, the reading with the vehicle resting on the floor (measured on the bench). EKF3 uses
                                 # it as the on-ground range (rngOnGnd, Measurements.cpp readRangeFinder)
RNGFND1_POS_X TODO_SUPERVISOR    # m, forward (measured)
RNGFND1_POS_Y TODO_SUPERVISOR    # m, right (measured)
RNGFND1_POS_Z TODO_SUPERVISOR    # m, down (measured). EKF3 corrects the range to the IMU with it (PosVelFusion.cpp:1270-1283);
                                 # the UKF port reads it from the log (R2)
RNGFND1_ADDR TODO_SUPERVISOR     # I2C address (I2C sensors only; 0 = driver default)
# Serial rangefinders only: the UART the sensor is wired to. n is board-specific (TODO_SUPERVISOR); then
#   SERIALn_PROTOCOL 9   (Rangefinder)   and   SERIALn_BAUD <sensor baud /1000, e.g. 115>
# Both names exist (SERIAL3_/SERIAL4_ in the SITL dump; libraries/AP_SerialManager/AP_SerialManager.cpp). Add the two
# lines here once the port is known.

# ---------------------------------------------------------------------------------------------------------------------
# IMU POSITION  (libraries/AP_InertialSensor/AP_InertialSensor.cpp @Param POS1_X/Y/Z)
# EKF3 and the UKF port measure every sensor lever arm relative to the active IMU (posOffset - INS_POSn).
# ---------------------------------------------------------------------------------------------------------------------
INS_POS1_X TODO_SUPERVISOR       # m, IMU 1 forward of the body origin (0 if the FC sits on the origin; measured)
INS_POS1_Y TODO_SUPERVISOR       # m, right
INS_POS1_Z TODO_SUPERVISOR       # m, down

# ---------------------------------------------------------------------------------------------------------------------
# NO GPS  (libraries/AP_GPS/AP_GPS_Params.cpp @Param TYPE, instance 1 = GPS1_TYPE)
# ---------------------------------------------------------------------------------------------------------------------
GPS1_TYPE 0              # no GPS fitted. With a GPS configured, the GPS arming check fails ("GPS 1: Bad fix") even
                         # though EKF3 does not use it (CLAUDE.md Hidden Configuration Audit section 2). No SIM_* exists
                         # on a real FC: the simulation's SIM_GPS1_ENABLE is NOT carried over.

# ---------------------------------------------------------------------------------------------------------------------
# ARMING CHECKS: NOT SKIPPED  (libraries/AP_Arming/AP_Arming.cpp @Param SKIPCHK)
# NOTE: at this commit the parameter is ARMING_SKIPCHK (a bitmask of checks to SKIP). There is NO "ARMING_CHECK"
# parameter in the pinned build's dump; CLAUDE.md's ARMING_CHECK wording is stale.
# ---------------------------------------------------------------------------------------------------------------------
ARMING_SKIPCHK 0         # skip nothing: every arming check runs (rangefinder, compass health, INS, logging, ...)

# ---------------------------------------------------------------------------------------------------------------------
# GEOFENCE: the box set by the mocap volume  (libraries/AC_Fence/AC_Fence.cpp)
# With no GPS there is no absolute position: circle/polygon fences need a home and a relative position
# ("Fence requires position", AC_Fence.cpp:509-516), and would follow EKF3's DRIFTING flow position. Only the MAXIMUM
# ALTITUDE fence is used. The horizontal limit is the safety pilot's, with a person watching mocap (flight cards).
# ---------------------------------------------------------------------------------------------------------------------
FENCE_ENABLE 1           # fence on
FENCE_TYPE 1             # bitmask: bit 0 = maximum altitude ONLY (bits 1-3 circle/polygon/min alt are NOT set)
FENCE_ALT_MAX_TP 1       # the max-altitude frame: 1 = above home (EKF3's height). NOT 3 "above terrain", which needs a
                         # terrain database and a location and would read as a permanent breach without GPS
FENCE_ALT_MAX TODO_SUPERVISOR    # m: the mocap volume's usable top minus a margin (e.g. 0.5-1.0 m below the ceiling/net)
FENCE_MARGIN TODO_SUPERVISOR     # m: kept from the fence (default 2; reduce for a small volume)
FENCE_ACTION 2           # 2 = Always Land (Copter @Values). RTL needs a position this vehicle does not have.
# BENCH CHECK (flight cards B6): the fence pre-arm passes and FENCE_STATUS reports the altitude fence enabled. The
# above-home height without a GPS home is EKF3's origin-relative height: confirm the reported height on the bench.

# ---------------------------------------------------------------------------------------------------------------------
# FAILSAFES  (ArduCopter/Parameters.cpp; libraries/AP_BattMonitor/AP_BattMonitor_Params.cpp)
# The vehicle's own tune is kept; these are read back and set only if the vehicle's values are weaker.
# ---------------------------------------------------------------------------------------------------------------------
FS_EKF_ACTION 1          # EKF failsafe: Land if the mode needs a position (ALT_HOLD does not; LOITER would)
FS_THR_ENABLE 3          # RC loss: always Land (@Values 3)
BATT_FS_LOW_ACT 1        # battery low: Land
BATT_FS_CRT_ACT 1        # battery critical: Land
BATT_LOW_VOLT TODO_SUPERVISOR    # V, for the vehicle's pack
BATT_CRT_VOLT TODO_SUPERVISOR    # V, for the vehicle's pack

# ---------------------------------------------------------------------------------------------------------------------
# FLIGHT MODES on the mode switch  (ArduCopter/Parameters.cpp FLTMODE_CH, FLTMODE1-6; mode numbers ArduCopter/mode.h)
# Recommended: the pilot flies ALT_HOLD (2) so the horizontal path does not depend on any estimator; STABILIZE (0) is the
# last resort; LAND (9). The switch positions are the pilot's choice (TODO_SUPERVISOR); keep exactly these three.
# ---------------------------------------------------------------------------------------------------------------------
FLTMODE_CH TODO_SUPERVISOR       # the RC channel of the mode switch (vehicle-specific)
FLTMODE1 TODO_SUPERVISOR         # e.g. 0 STABILIZE
FLTMODE4 TODO_SUPERVISOR         # e.g. 2 ALT_HOLD
FLTMODE6 TODO_SUPERVISOR         # e.g. 9 LAND

# ---------------------------------------------------------------------------------------------------------------------
# LOGGING: replayable logs from the first power-up  (libraries/AP_Logger/AP_Logger.cpp; ArduCopter/Parameters.cpp)
# ---------------------------------------------------------------------------------------------------------------------
LOG_REPLAY 1             # write the DAL replay records (RFRH/RFRF, RISH/RISI, ROFH, RRNH/RRNI, ...): REQUIRED for EKF3
                         # and the UKF port in Replay and for the FGO converter
LOG_DISARMED 1           # log while disarmed: the sync wiggles before arming and after landing are in the log
LOG_BITMASK 180222       # Copter default made explicit: bits 1-13, 15, 17 (medium attitude, GPS, PM, CTUN, NTUN, RCIN,
                         # IMU (7), CMD, BATT, RCOU, OPTICAL FLOW (11), PID, COMPASS, CAMERA, MOTORS); decoded from the
                         # @Bitmask list. The full-rate IMU for the estimators comes from RISI (LOG_REPLAY), not from
                         # bit 18/19, which are not needed.
LOG_FILE_BUFSIZE TODO_SUPERVISOR # KB of log buffer: raise to the board's maximum safe value (e.g. 64-200 on an H7) to
                                 # avoid dropped blocks with LOG_REPLAY; check DSF after every flight (flight cards)
LOG_FILE_DSRMROT 0       # do not start a new log file at each disarm (one file holds both sync wiggles)
