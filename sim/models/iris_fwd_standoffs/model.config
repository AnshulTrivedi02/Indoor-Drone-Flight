<?xml version="1.0"?>
<model>
  <name>iris_fwd_standoffs</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    Copy of ardupilot_gazebo iris_with_standoffs (thesis downward camera + gpu_lidar,
    ardupilot_gazebo d1eaad3) plus a level forward camera. Meshes resolve from
    model://iris_with_standoffs (~/ardupilot_gazebo). fwd-camera workstream.
  </description>
</model>
