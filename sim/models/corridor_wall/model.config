<?xml version="1.0" ?>
<model>
  <name>corridor_wall</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    Plain grey boundary wall for the corridor worlds (corridor_textured /
    corridor_blank / corridor_transition). 170 m long (x0.2 x5), included
    twice per world (mirrored in X) to bound a 20 m wide, 160 m long flight
    corridor. Identical across all three corridor worlds so it never
    confounds the floor-texture comparison.
  </description>
</model>
