<?xml version="1.0"?>
<model>
  <name>iris_fwd_ts</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    Copy of ardupilot_gazebo iris_with_ardupilot (lift-drag + ArduPilotPlugin) that
    includes iris_fwd_standoffs (forward camera) instead of iris_with_standoffs.
    fwd-camera workstream.
  </description>
  <depend><model><uri>model://iris_fwd_standoffs</uri></model></depend>
</model>
